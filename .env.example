# Postgres connection string used by lib/db and the api-server package.
DATABASE_URL=postgres://user:password@localhost:5432/devdex

# Used by the Vite dev servers (artifacts/devdex, artifacts/mockup-sandbox).
PORT=5173
BASE_PATH=/

# Environment for the api-server build/start scripts.
NODE_ENV=development

# Google OAuth (for "Continue with Google"). Create credentials at
# https://console.cloud.google.com/apis/credentials — Authorized redirect URI
# must exactly match GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Where to send the browser back to after a Google login (your deployed frontend URL)
FRONTEND_URL=http://localhost:5173
